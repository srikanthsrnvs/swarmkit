#!/usr/bin/env bash
# Network via HTTPS relay, or through the configured gateway into your sandbox's daemon.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd); KIT=$(cd "$HERE/../../.." && pwd)
if [ -n "${AGENTNET_URL:-}" ]; then
  : "${AGENTNET_TOKEN:?set AGENTNET_TOKEN}"
  REF=${AGENT_NETWORK_TAG:-$(cat "$KIT/agent-network.ref")}
  AN=${AGENT_NETWORK:-$KIT/.cache/agent-network-$REF}
  exec node "$AN/packages/cli/bin/anet.mjs" "$@"
fi
: "${SWARM_GATEWAY_HOST:?set AGENTNET_URL/token or SWARM_GATEWAY_HOST/token}"
if [ "${1:-}" = send ] && [ "${3:-}" = --file ]; then
  target=$(printf '%q' "$2"); exec "$HERE/sc" --stdin "anet send $target -" < "$4"
fi
if [ "${1:-}" = send ] && [ "${3:-}" = - ]; then
  target=$(printf '%q' "$2"); exec "$HERE/sc" --stdin "anet send $target -"
fi
q=""; for arg in "$@"; do q+=" $(printf '%q' "$arg")"; done
exec "$HERE/sc" "anet$q"
