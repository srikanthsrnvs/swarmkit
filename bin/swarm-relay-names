#!/usr/bin/env bash
# Sync contacts only into this swarm's relay identities. Never overwrite the shared relay address book.
set -euo pipefail
SWARM=${SWARM_DIR:-$HOME/swarms/default}; RHOME=${RELAY_HOME:-$HOME/relay}
quiet=0
while [ $# -gt 0 ]; do case "$1" in --relay-home) RHOME=$2; shift 2;; -q|--quiet) quiet=1; shift;; *) echo "usage: swarm-relay-names [--relay-home DIR] [-q]" >&2; exit 2;; esac; done
[ -f "$SWARM/names.json" ] || { echo "no swarm names.json" >&2; exit 1; }
[ -f "$SWARM/relay-agents.json" ] || exit 0
while read -r identity; do
  [[ "$identity" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || exit 1
  home="$RHOME/identities/$identity"
  [ -d "$home" ] || { echo "relay identity $identity is on another host; use anet contacts --file names.json there" >&2; continue; }
  tmp=$(mktemp "$home/.names.XXXXXX")
  cp "$SWARM/names.json" "$tmp"; chmod 600 "$tmp"; mv "$tmp" "$home/names.json"
  if [ $quiet = 0 ]; then echo "synced swarm contacts for $identity"; fi
 done < <(jq -r '.[]' "$SWARM/relay-agents.json")
