#!/usr/bin/env bash
# Teach a same-box relay this swarm's names: merge $SWARM_DIR/names.json into the relay's shared names.json
# (the relay re-reads it on change), so cloud agents on the relay can address sandbox agents by name and see
# their posts labelled with names instead of 0x addresses.
#   bin/swarm-relay-names [--relay-home DIR] [-q]
# The relay home is $RELAY_HOME, else ~/relay; when it does not exist this is a no-op (the relay runs elsewhere:
# copy the swarm's names.json entries into that host's RELAY_HOME/names.json by hand). Adds names the relay does
# not know; a name the relay already maps to a DIFFERENT address is left alone with a warning (two swarms may
# share a relay; pick distinct agent names). add-agent.sh, swarm-init and swarm-join call this after every change.
set -euo pipefail
SWARM=${SWARM_DIR:-$HOME/swarms/default}
RHOME=${RELAY_HOME:-$HOME/relay}
quiet=0
while [ $# -gt 0 ]; do case "$1" in
  --relay-home) RHOME=$2; shift 2;; -q|--quiet) quiet=1; shift;;
  -h|--help) sed -n '2,9p' "$0"; exit 0;; *) echo "unknown flag $1" >&2; exit 1;; esac; done
[ -f "$SWARM/names.json" ] || { echo "no $SWARM/names.json (SWARM_DIR?)" >&2; exit 1; }
if [ ! -f "$RHOME/names.json" ]; then
  [ $quiet = 1 ] || echo "no relay on this host ($RHOME/names.json missing): cloud agents need these entries in their relay's names.json"
  exit 0
fi
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
added=$(jq -r -s '.[0] as $r | .[1] | to_entries[] | select($r[.key] == null) | .key' "$RHOME/names.json" "$SWARM/names.json" | tr '\n' ' ')
jq -r -s '.[0] as $r | .[1] | to_entries[] | select($r[.key] != null and $r[.key] != .value) | .key' "$RHOME/names.json" "$SWARM/names.json" \
  | while read -r n; do echo "warning: the relay already maps '$n' to a different address; left unchanged (rename the agent or edit $RHOME/names.json)" >&2; done
if [ -n "$added" ]; then
  tmp=$(mktemp)
  jq -s '.[0] as $r | $r + (.[1] | with_entries(select($r[.key] == null)))' "$RHOME/names.json" "$SWARM/names.json" > "$tmp"
  mv "$tmp" "$RHOME/names.json" && chmod 644 "$RHOME/names.json"
  echo "relay names: added $added-> $RHOME/names.json"
else
  [ $quiet = 1 ] || echo "relay names: nothing new for $RHOME/names.json"
fi
