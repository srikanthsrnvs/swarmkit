#!/usr/bin/env bash
# A durable host-side watch loop; no platform-specific cron/Monitor dependency.
# Run in this swarm's tmux server. --inbox opts into consuming the owner inbox (one reader only).
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd); SWARM=${SWARM_DIR:-$HOME/swarms/default}
interval=240; inbox=0
while [ $# -gt 0 ]; do case "$1" in --interval) interval=$2; shift 2;; --inbox) inbox=1; shift;; *) exit 2;; esac; done
[[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -ge 5 ] || { echo "interval must be >=5 seconds" >&2; exit 1; }
mkdir -p "$SWARM/logs"
while true; do
  { date -u +%FT%TZ; if command -v docker >/dev/null; then "$HERE/swarmctl" status || echo "status check failed"; else "$HERE/swarm-join" status || echo "status check failed"; fi;
    if [ $inbox = 1 ]; then "$HERE/swarm-say" --inbox --wait 1 || echo "inbox check failed"; fi;
  } >> "$SWARM/logs/watch.log" 2>&1
  sleep "$interval"
done
